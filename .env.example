# FamQuest – Konfiguration
# Kopieren nach .env und anpassen:  cp .env.example .env
# Die .env wird nie committet.

# --- Datenbank (PostgreSQL) ---------------------------------------------------
POSTGRES_USER=famquest
# Pflicht. Ein langes, zufälliges Passwort, z. B.:  openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=famquest

# --- App -------------------------------------------------------------------------
# Port auf dem Host, unter dem die App erreichbar ist (http://<host>:8080).
# Hinter einem Reverse Proxy auf demselben Host: 127.0.0.1:8080
APP_PORT=8080
# Log-Level: critical, error, warning, info, debug
# debug zur Fehlersuche, z. B. bei Problemen mit der Anmeldung (zeigt auch eingegebene E-Mails).
LOG_LEVEL=info
# IP-Adressen (kommagetrennt) von Reverse Proxies, deren X-Forwarded-*-Headern
# vertraut wird. Ohne Reverse Proxy so lassen. "*" nur, wenn die App ausschließlich
# über den Proxy erreichbar ist (z. B. APP_PORT=127.0.0.1:8080). Siehe README.
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Google Kalender (optional) ---------------------------------------------------
# Ohne diese drei Werte ist der Kalender abgeschaltet. Einrichtung: README, Abschnitt „Google Kalender“.
# Zugangsdaten des OAuth-Clients (Typ „Webanwendung“) aus der Google Cloud Console:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Verschlüsselt die Google-Tokens in der Datenbank, z. B.:  openssl rand -base64 32
# Geht er verloren oder wird geändert, müssen die Google-Konten neu verbunden werden.
TOKEN_ENCRYPTION_KEY=
# Minuten zwischen zwei Abgleichen mit Google im Hintergrund (0 = aus).
# CALENDAR_SYNC_MINUTES=5

# --- Reverse Proxy im Docker-Netzwerk (optional) ------------------------------------
# Läuft der Proxy (z. B. Nginx Proxy Manager) als Container in einem eigenen Docker-Netzwerk,
# diese beiden Zeilen einkommentieren. Die App ist dann im Netzwerk als famquest:8000 erreichbar,
# APP_PORT wird nicht mehr auf dem Host veröffentlicht, FORWARDED_ALLOW_IPS ist dann standardmäßig *.
# COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml
# PROXY_NETWORK=proxy

# --- Nur lokale Entwicklung ---------------------------------------------------------
# Veröffentlicht zusätzlich den Datenbank-Port auf 127.0.0.1, damit Backend und
# Tests direkt auf dem Rechner laufen können. Auf dem Server auskommentiert lassen.
# COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
# DB_PORT=5432
